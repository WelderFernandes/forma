# Postgres local (docker compose up -d postgres)
DATABASE_URL="postgresql://forma:forma_dev_password@localhost:5433/forma?schema=public"
# Em provedores com pooler, use a URL direta para migrations. Localmente é a mesma.
DIRECT_URL="postgresql://forma:forma_dev_password@localhost:5433/forma?schema=public"
BETTER_AUTH_SECRET="troque-por-um-segredo-aleatorio-de-64-caracteres"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Opcional: máximo de conexões do pool por processo (padrão: 10).
# DATABASE_POOL_MAX="10"
MUSCLEWIKI_API_KEY=""
MUSCLEWIKI_BASE_URL="https://api.musclewiki.com"

# ExerciseDB Free: GIFs de 180p com licença de uso não comercial.
# Deixe "false" em uma publicação comercial; os vídeos do Your Move
# continuam disponíveis e são a camada principal gratuita.
EXERCISEDB_FREE_ENABLED="false"
